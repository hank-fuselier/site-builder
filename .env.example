# Copy to .env and fill in.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# The address customers will use for preview links (no trailing slash)
PUBLIC_BASE_URL=http://your-server:8080
# Shown as "Website by ..." in each site's footer (leave blank to hide)
BUILDER_NAME=

# Port the app listens on when you're not using the bundled Caddy
APP_PORT=8080
# 127.0.0.1 keeps the app private to this machine (use a reverse proxy or SSH tunnel); 0.0.0.0 exposes it
APP_BIND=127.0.0.1

# Only for the Caddy profile (automatic HTTPS):
SITE_HOST=sites.example.com
ACME_EMAIL=you@example.com
